---
import '../styles/global.css';
import PebbleMark from '../components/PebbleMark.astro';
interface Props { title: string; description?: string; }
const { title, description = 'Thriai designs, builds and runs your AI-native finance function. Senior finance expertise, applied directly to the systems that move your business forward.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = Astro.url.pathname === '/';
const ld = { '@context':'https://schema.org', '@type':'ProfessionalService', name:'Thriai LLC', url:'https://thriai.io', email:'hello@thriai.io', description:'Senior finance leadership and hands-on AI-native finance systems implementation.', areaServed:'United States' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/space-grotesk-bold.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Thriai" />
    <meta name="theme-color" content="#080b10" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class:list={[home ? 'home-page' : 'interior-page']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="wrap" aria-label="Main navigation">
        <a class="logo" href="/" aria-label="Thriai home">thri<span>ai</span><i aria-hidden="true"><PebbleMark /></i></a>
        <span class="nav-descriptor">FINANCE. BUILT TOGETHER.</span>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">Menu <span aria-hidden="true">+</span></button>
        <div class="links" id="nav-links">
          <a href="/#services">Services</a><a href="/pricing">Pricing</a><a href="/about">About</a>
          <a href="/contact" class="nav-contact">Let's build <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <main id="main">{!home && <div class="interior-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>}<slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-signature" aria-hidden="true"><span>thriai<i><PebbleMark /></i></span><div class="footer-system"><b>RECORDS</b><i></i><b>MODEL</b><i></i><b>DECISION</b></div></div>
        <div class="footer-top"><a class="logo" href="/" aria-label="Thriai home">thri<span>ai</span><i aria-hidden="true"><PebbleMark /></i></a><p>Senior judgment.<br />Hands-on implementation.</p><div class="footer-links"><a href="/pricing">Pricing ↗</a><a href="/about">About ↗</a><a href="/contact">Contact ↗</a><a href="mailto:hello@thriai.io">hello@thriai.io ↗</a></div></div>
        <div class="footer-bottom"><p>© {new Date().getFullYear()} Thriai LLC · Sheridan, Wyoming</p><p>Finance advisory, FP&amp;A and systems services. We do not provide audit, review, attest or tax return preparation services.</p></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const links = document.getElementById('nav-links');
      const closeMenu = () => { toggle?.setAttribute('aria-expanded','false'); links?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); links?.classList.toggle('is-open',open); });
      links?.querySelectorAll('a').forEach(link => link.addEventListener('click',closeMenu));
      document.addEventListener('keydown', e => { if(e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
    </script>
  </body>
</html>
